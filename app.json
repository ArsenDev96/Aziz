{
  "expo": {
    "name": "AZIZ",
    "slug": "aziz",
    "scheme": "aziz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0B1A",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "am.aziz.party"
    },
    "android": {
      "package": "am.aziz.party",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-foreground.png",
        "backgroundColor": "#0E0B1A",
        "monochromeImage": "./assets/branding/monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/splash-logo.png",
          "backgroundColor": "#0E0B1A",
          "resizeMode": "contain",
          "imageWidth": 220
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2313a469-7f00-4adf-bdab-4f56060db37e"
      }
    }
  }
}
